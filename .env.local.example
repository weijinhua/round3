# Frontend environment variables
# Copy to apps/web/.env.local for local development

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=zh-CN

# Backend environment variables (copy to apps/api/.env.local)
DATABASE_URL=postgresql://charts_user:charts_password@localhost:5432/charts_generator
REDIS_URL=redis://localhost:6379
MAILER_PROVIDER=mailhog
MAILER_URL=smtp://localhost:1025
MAILER_FROM="no-reply@example.com"
JWT_SECRET=changeme-jwt-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
